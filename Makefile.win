# Native Windows build: MSYS2 UCRT64 + PDCursesMod (wide/UTF-8).
# VT is the only backend (mintty, Windows Terminal, and Console Host).
# The Unix build remains in Makefile. Windows does not use ./configure.
#
# pacman -S --needed make mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-binutils mingw-w64-ucrt-x86_64-pdcurses
# make clean && make
# make PROGRAM=rogue_original original
# make wizard
# make FILEDIR=saved-games  # Personal build: Saved Games/Rogue/3.6

CC = gcc
WINDRES ?= windres
ICON_OBJ := windows/rogue-icon.win.o
MINGW_PREFIX ?= /ucrt64
# Do not silently accept the obsolete backend selector.
# Windows builds use the PDCursesMod VT backend on every supported console.
ifneq ($(origin PDC_BACKEND),undefined)
$(error PDC_BACKEND is obsolete; Windows builds always use the VT backend)
endif
PROG ?= rogue

# PROGRAM is an alternative name for PROG on the make command line.
# Keep an explicit PROG= authoritative if both variables are provided.
# Use override so PROGRAM= can replace PROG set by ./configure (config.mk).
ifneq ($(strip $(PROGRAM)),)
ifneq ($(origin PROG),command line)
override PROG := $(PROGRAM)
endif
endif
DEFAULT_LANGUAGE ?= 0
FILEDIR ?=

# Windows only: resolve FILEDIR=saved-games to the current user's actual
# Saved Games known folder, including redirected locations, then use /Rogue/3.6.
# The absolute path is embedded at build time: never use for public binaries.
# Do not invoke PowerShell for clean, distclean, or source archive creation.
ifeq ($(strip $(FILEDIR)),saved-games)
ifneq ($(filter-out clean distclean dist.src dist.win,$(if $(strip $(MAKECMDGOALS)),$(MAKECMDGOALS),all)),)
SAVED_GAMES_FILEDIR := $(shell powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./windows/windows-saved-games.ps1)
ifeq ($(strip $(SAVED_GAMES_FILEDIR)),)
$(error Cannot resolve the Windows Saved Games known folder; check PowerShell and windows-saved-games.ps1)
endif
RESOLVED_FILEDIR := $(SAVED_GAMES_FILEDIR)
AUTO_PREPARE_FILEDIR := 1
endif
else
RESOLVED_FILEDIR := $(FILEDIR)
endif

# Explicit SAVEDIR/SCOREDIR/LOCKDIR take precedence over FILEDIR.
SAVEFILE ?= $(PROG).save
SAVEDIR ?= $(if $(RESOLVED_FILEDIR),$(RESOLVED_FILEDIR),.)
SCOREFILE ?= $(PROG).scr
SCOREDIR ?= $(if $(RESOLVED_FILEDIR),$(RESOLVED_FILEDIR),.)
LOCKFILE ?= $(PROG).lock
LOCKDIR ?= $(if $(RESOLVED_FILEDIR),$(RESOLVED_FILEDIR),.)
CFLAGS ?= -std=gnu89 -O2 -g -Wall -Wextra
USER_CPPFLAGS := $(CPPFLAGS)
EXTRA_CPPFLAGS ?=
LDFLAGS ?=

# MSYS2 shell quoting: argument values containing spaces stay valid C strings.
shell_quote = '$(subst ','"'"',$(1))'
override CPPFLAGS := -D_DEFAULT_SOURCE -D_XOPEN_SOURCE=600 \
    -DPDC_WIDE=1 -DPDC_FORCE_UTF8=1 \
    -I. -I$(MINGW_PREFIX)/include/pdcurses \
    -DROGUE_SAVEFILE=$(call shell_quote,"$(SAVEFILE)") \
    -DROGUE_SAVEDIR=$(call shell_quote,"$(SAVEDIR)") \
    -DROGUE_SCOREFILE=$(call shell_quote,"$(SCOREFILE)") \
    -DROGUE_SCOREDIR=$(call shell_quote,"$(SCOREDIR)") \
    -DROGUE_LOCKFILE=$(call shell_quote,"$(LOCKFILE)") \
    -DROGUE_LOCKDIR=$(call shell_quote,"$(LOCKDIR)") \
    -DDEFAULT_LANGUAGE=$(DEFAULT_LANGUAGE) $(USER_CPPFLAGS) $(EXTRA_CPPFLAGS)
ifeq ($(WIZARD),1)
override CPPFLAGS += -DWIZARD
endif

LDLIBS ?= -lpdcurses_vt -lwinmm -luser32 -lgdi32 -lcomdlg32 -lshell32 -lshlwapi -ladvapi32

SRCS := armor.c chase.c command.c daemon.c daemons.c fight.c init.c io.c \
    list.c main.c misc.c monsters.c move.c new_level.c options.c pack.c \
    passages.c potions.c rings.c rip.c rooms.c save.c scrolls.c sticks.c \
    things.c weapons.c wizard.c vers.c globals.c getpass.c jec/language.c \
    windows/rogue_windows.c windows/rogue_windows_console.c windows/unicode_output.c jec/unicode_text.c jec/screen_text.c xcrypt.c
OBJS := $(SRCS:.c=.win.o)

.PHONY: all clean distclean japanese english original wizard install prepare-filedir
all: $(PROG).exe

# Only saved-games builds automatically create the directory.  Plain FILEDIR
# keeps the old behavior; its directory can be made explicitly by invoking
# make prepare-filedir FILEDIR=path in an MSYS2 UCRT64 shell.
ifeq ($(AUTO_PREPARE_FILEDIR),1)
$(PROG).exe: | prepare-filedir
endif
prepare-filedir:
ifeq ($(strip $(RESOLVED_FILEDIR)),)
	@echo "FILEDIR is unset; data files use the current directory."
else
ifeq ($(AUTO_PREPARE_FILEDIR),1)
	@powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./windows/windows-saved-games.ps1 -Create
else
	@mkdir -p "$$(cygpath -u "$(RESOLVED_FILEDIR)")"
endif
endif

# Track all effective compiler, linker and resource settings, including
# overrides from make's command line and the active MSYS2 installation.
# Keep the timestamp unchanged if the settings have not changed, so a
# second invocation of make does not rebuild unchanged objects.
.PHONY: FORCE_WINDOWS_CONFIG
FORCE_WINDOWS_CONFIG:

.windows-build-config: FORCE_WINDOWS_CONFIG
	@printf '%s\n' \
		$(call shell_quote,PROG=$(PROG)) \
		$(call shell_quote,CC=$(CC)) \
		$(call shell_quote,CFLAGS=$(CFLAGS)) \
		$(call shell_quote,CPPFLAGS=$(CPPFLAGS)) \
		$(call shell_quote,LDFLAGS=$(LDFLAGS)) \
		$(call shell_quote,LDLIBS=$(LDLIBS)) \
		$(call shell_quote,WINDRES=$(WINDRES)) \
		$(call shell_quote,MINGW_PREFIX=$(MINGW_PREFIX)) \
		$(call shell_quote,WIZARD=$(WIZARD)) > $@.tmp
	@if test -f $@ && cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi
$(OBJS): .windows-build-config

# Embed the same multi-resolution icon in all Windows executables.
# Also recompile the icon if the resource compiler or build setup changes.
$(ICON_OBJ): windows/rogue-icon.rc windows/rogue.ico .windows-build-config
	$(WINDRES) -Iwindows -i windows/rogue-icon.rc -O coff -o $@

%.win.o: %.c rogue.h mach_dep.h windows/rogue_windows.h windows/rogue_windows_console.h jec/language.h jec/unicode_text.h jec/unicode_output.h jec/screen_text.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

$(PROG).exe: $(OBJS) $(ICON_OBJ)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(ICON_OBJ) $(LDLIBS)

japanese:
	$(MAKE) -f Makefile.win clean PROG=$(PROG)
	$(MAKE) -f Makefile.win all PROG=$(PROG) DEFAULT_LANGUAGE=1
english:
	$(MAKE) -f Makefile.win clean PROG=$(PROG)
	$(MAKE) -f Makefile.win all PROG=$(PROG) DEFAULT_LANGUAGE=2
original: english
wizard:
	$(MAKE) -f Makefile.win clean PROG=$(PROG)
	$(MAKE) -f Makefile.win all PROG=$(PROG) WIZARD=1

# Windows binary files are intentionally relative to the working directory
# (the extracted distribution folder when launched from Explorer).
install:
	@echo 'Windows build: copy the .exe and README files to your distribution folder.'

clean:
	rm -f $(OBJS) language.win.o unicode_text.win.o screen_text.win.o rogue_windows.win.o rogue_windows_console.win.o unicode_output.win.o rogue-icon.win.o $(ICON_OBJ) $(PROG).exe .windows-build-config .windows-build-config.tmp

distclean: clean
	@echo 'Windows build does not use ./configure or config.mk.'

# Windows binary archive target: release documents are kept in windows/binary/.
include dist-win.mk

# Shared source archive target (also used by Makefile on Unix).
include dist-src.mk
