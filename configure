#!/bin/sh
set -eu

CC=${CC:-cc}
PROG=rogue
PREFIX=/usr/local
BINDIR='$(PREFIX)/bin'
FILEDIR=''
SAVEFILE='$(PROG).save'
SAVEDIR='.'
SCOREFILE='$(PROG).scr'
SCOREDIR='.'
LOCKFILE='$(PROG).lock'
LOCKDIR='.'
savedir_set=0
scoredir_set=0
lockdir_set=0
CFLAGS='-std=gnu89 -Wall -Wextra -Werror'
CPPFLAGS='-D_DEFAULT_SOURCE -D_XOPEN_SOURCE=600'
LDLIBS=''
DEFAULT_LANGUAGE=0
LOG=config.log

usage() {
    cat <<USAGE
Usage: ./configure [options]

Options:
  --program=NAME          executable name (default: rogue)
  --prefix=DIR            installation prefix (default: /usr/local)
  --bindir=DIR            executable install directory (default: \$(prefix)/bin)
  --file-dir=DIR          common directory for save, score, and lock files
                          make install creates this directory if needed
  --savefile=NAME         save file name (default: \$(PROG).save)
  --savedir=DIR           directory for simple save file names (default: .)
  --scorefile=NAME        score file name (default: \$(PROG).scr)
  --scoredir=DIR          score file directory (default: .)
  --lockfile=NAME         score lock file name (default: \$(PROG).lock)
  --lockdir=DIR           score lock file directory (default: .)
  --cc=CC                 C compiler (default: cc or CC environment variable)
  --cflags=FLAGS          C compiler flags
  --cppflags=FLAGS        C preprocessor flags
  --ldlibs=LIBS           linker libraries; skips automatic library detection
                          UTF-8 Japanese display uses ncursesw when available
  --default-language=LANG default language: auto, ja, or en
  --japanese              same as --default-language=ja
  --english               same as --default-language=en
  --help                  show this help

Examples:
  ./configure --program=rogue36 --file-dir=.
  ./configure --program=rogue36 --file-dir='~/Library/Application Support/rogue36'
  ./configure --program=rogue36 --file-dir=. --scoredir='~/.local/share/rogue36'
USAGE
}

for opt in "$@"; do
    case "$opt" in
        --help) usage; exit 0 ;;
        --program=*) PROG=${opt#*=} ;;
        --prefix=*) PREFIX=${opt#*=} ;;
        --bindir=*) BINDIR=${opt#*=} ;;
        --file-dir=*) FILEDIR=${opt#*=} ;;
        --savefile=*) SAVEFILE=${opt#*=} ;;
        --savedir=*) SAVEDIR=${opt#*=}; savedir_set=1 ;;
        --scorefile=*) SCOREFILE=${opt#*=} ;;
        --scoredir=*) SCOREDIR=${opt#*=}; scoredir_set=1 ;;
        --lockfile=*) LOCKFILE=${opt#*=} ;;
        --lockdir=*) LOCKDIR=${opt#*=}; lockdir_set=1 ;;
        --cc=*) CC=${opt#*=} ;;
        --cflags=*) CFLAGS=${opt#*=} ;;
        --cppflags=*) CPPFLAGS=${opt#*=} ;;
        --ldlibs=*) LDLIBS=${opt#*=} ;;
        --default-language=*)
            case ${opt#*=} in
                auto|AUTO|0) DEFAULT_LANGUAGE=0 ;;
                ja|JA|japanese|Japanese|1) DEFAULT_LANGUAGE=1 ;;
                en|EN|english|English|2) DEFAULT_LANGUAGE=2 ;;
                *) echo "configure: invalid default language: ${opt#*=}" >&2; exit 1 ;;
            esac ;;
        --japanese) DEFAULT_LANGUAGE=1 ;;
        --english) DEFAULT_LANGUAGE=2 ;;
        *) echo "configure: unknown option: $opt" >&2; usage >&2; exit 1 ;;
    esac
done

# Expand a leading ~/ at configuration time, rather than recording a
# literal tilde in config.mk.  The arguments are commonly shell-quoted, so
# the invoking shell will not perform tilde expansion for us.
expand_home_path() {
    case $1 in
        '~'|'~/'*)
            if [ -z "${HOME:-}" ]; then
                echo "configure: HOME is required to expand ~ in a directory" >&2
                exit 1
            fi
            case $1 in
                '~') expanded_path=$HOME ;;
                '~/'*) expanded_path=${HOME%/}/${1#\~/} ;;
            esac ;;
        *) expanded_path=$1 ;;
    esac
}

expand_home_path "$FILEDIR"; FILEDIR=$expanded_path
expand_home_path "$SAVEDIR"; SAVEDIR=$expanded_path
expand_home_path "$SCOREDIR"; SCOREDIR=$expanded_path
expand_home_path "$LOCKDIR"; LOCKDIR=$expanded_path

if [ -n "$FILEDIR" ]; then
    if [ "$savedir_set" -eq 0 ]; then
        SAVEDIR=$FILEDIR
    fi
    if [ "$scoredir_set" -eq 0 ]; then
        SCOREDIR=$FILEDIR
    fi
    if [ "$lockdir_set" -eq 0 ]; then
        LOCKDIR=$FILEDIR
    fi
fi

: > "$LOG"

cat > conftest.c <<'C'
#include <curses.h>
int main(void) { initscr(); endwin(); return 0; }
C

try_link() {
    libs=$1
    echo "$CC $CPPFLAGS $CFLAGS conftest.c $libs -o conftest" >> "$LOG"
    $CC $CPPFLAGS $CFLAGS conftest.c $libs -o conftest >> "$LOG" 2>&1
}

if [ -z "$LDLIBS" ]; then
    if try_link "-lncursesw"; then
        LDLIBS='-lncursesw'
    elif try_link "-lncurses"; then
        LDLIBS='-lncurses'
    elif try_link "-lcurses"; then
        LDLIBS='-lcurses'
    else
        echo "configure: could not link a curses test program" >&2
        echo "configure: install ncurses development files or pass --ldlibs='-lncursesw'" >&2
        exit 1
    fi

    cat > conftest.c <<'C'
#include <unistd.h>
int main(void) { return crypt("test", "mT") == 0; }
C
    if try_link "$LDLIBS"; then
        :
    elif try_link "$LDLIBS -lcrypt"; then
        LDLIBS="$LDLIBS -lcrypt"
    else
        echo "configure: could not link crypt(3)" >&2
        echo "configure: try passing --ldlibs='$LDLIBS -lcrypt'" >&2
        exit 1
    fi
fi

cat > config.mk <<EOF_CONFIG
# Generated by ./configure.  Edit by hand only if you know what you are doing.
CC = $CC
PROG = $PROG
PREFIX = $PREFIX
BINDIR = $BINDIR
FILEDIR = $FILEDIR
SAVEFILE = $SAVEFILE
SAVEDIR = $SAVEDIR
SCOREFILE = $SCOREFILE
SCOREDIR = $SCOREDIR
LOCKFILE = $LOCKFILE
LOCKDIR = $LOCKDIR
CFLAGS = $CFLAGS
CPPFLAGS = $CPPFLAGS
LDLIBS = $LDLIBS
DEFAULT_LANGUAGE = $DEFAULT_LANGUAGE
EOF_CONFIG

rm -f conftest conftest.c

echo "Configuration written to config.mk"
echo "  CC        = $CC"
echo "  PROG      = $PROG"
echo "  PREFIX    = $PREFIX"
echo "  BINDIR    = $BINDIR"
if [ -n "$FILEDIR" ]; then
    echo "  FILEDIR   = $FILEDIR"
fi
echo "  SAVE      = $SAVEDIR/$SAVEFILE"
echo "  SCORE     = $SCOREDIR/$SCOREFILE"
echo "  LOCK      = $LOCKDIR/$LOCKFILE"
echo "  LDLIBS    = $LDLIBS"
case "$DEFAULT_LANGUAGE" in
    1) echo "  LANGUAGE  = ja" ;;
    2) echo "  LANGUAGE  = en" ;;
    *) echo "  LANGUAGE  = auto" ;;
esac
echo "Now run: make clean && make"
echo "Install with: make install"
